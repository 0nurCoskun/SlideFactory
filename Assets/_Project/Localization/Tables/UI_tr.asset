  m_TableData:
  - m_Id: 2059419648
    m_Localized: "\xD6\u011Fretici tamamland\u0131! Art\u0131k ger\xE7ek oyuna haz\u0131rs\u0131n."
    m_Metadata:
      m_Items: []
  - m_Id: 2084585472
    m_Localized: "Kart\u0131, o kenarda g\xF6sterilen istasyona do\u011Fru kayd\u0131r.
      Yanl\u0131\u015F istasyon mu? Sorun de\u011Fil - kart sadece s\u0131f\u0131rlan\u0131r!"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585473
    m_Localized: "Hata! Yanl\u0131\u015F istasyon - kart ham haline geri d\xF6nd\xFC.
      \u0130stasyon etiketlerini takip et!"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585474
    m_Localized: "Harika! Do\u011Fru kayd\u0131rmalar kart\u0131 ilerletir. \u0130stasyonlar
      zamanla yer de\u011Fi\u015Ftirir, dikkatli ol!"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585475
    m_Localized: 'Ham Madde: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 2084585476
    m_Localized: "\u0130stasyon Kar\u0131\u015Fmas\u0131: {0}-{1}sn"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585477
    m_Localized: "S\xFCre Limiti: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585478
    m_Localized: ": {0} i\xE7inde bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585479
    m_Localized: ": {0} i\xE7inde bitir"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585480
    m_Localized: Devam Et
    m_Metadata:
      m_Items: []
  - m_Id: 2084585481
    m_Localized: Duraklat
    m_Metadata:
      m_Items: []
  - m_Id: 2084585482
    m_Localized: "Yeniden Ba\u015Fla"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585483
    m_Localized: "Ana Men\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585484
    m_Localized: Seviyeler
    m_Metadata:
      m_Items: []
  - m_Id: 2084585485
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 2084585486
    m_Localized: Oyna
    m_Metadata:
      m_Items: []
  - m_Id: 2084585487
    m_Localized: "\xC7\u0131k\u0131\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585488
    m_Localized: Geri
    m_Metadata:
      m_Items: []
  - m_Id: 2084585489
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585490
    m_Localized: Efekt
    m_Metadata:
      m_Items: []
  - m_Id: 2084585491
    m_Localized: "\u0130lerlemeyi S\u0131f\u0131rla"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585492
    m_Localized: Tarifler
    m_Metadata:
      m_Items: []
  - m_Id: 2084585493
    m_Localized: Kapat
    m_Metadata:
      m_Items: []
  - m_Id: 2084585494
    m_Localized: Sonraki Seviye
    m_Metadata:
      m_Items: []
  - m_Id: 2084585495
    m_Localized: Tebrikler!
    m_Metadata:
      m_Items: []
  - m_Id: 2084585496
    m_Localized: "S\xFCre Doldu!"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585497
    m_Localized: Malzemeler
    m_Metadata:
      m_Items: []
  - m_Id: 2084585498
    m_Localized: "Seviye Ad\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585499
    m_Localized: "\u0130stasyon Kar\u0131\u015Fmas\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585500
    m_Localized: "Toplam S\xFCre"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585501
    m_Localized: "\xDC\xE7 Y\u0131ld\u0131z S\xFCresi"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585502
    m_Localized: "\u0130ki Y\u0131ld\u0131z S\xFCresi"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585503
    m_Localized: "\xD6\u011Fretici"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585504
    m_Localized: Mutfak
    m_Metadata:
      m_Items: []
  - m_Id: 2084585505
    m_Localized: "Orta \xC7a\u011F"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585506
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 2084585507
    m_Localized: English
    m_Metadata:
      m_Items: []
  - m_Id: 2084585508
    m_Localized: "T\xFCrk\xE7e"
    m_Metadata:
      m_Items: []
  - m_Id: 2084585509
    m_Localized: "Tamamland\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 2024595754336256
    m_Localized: "Simyac\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113472
    m_Localized: Puan
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113473
    m_Localized: 'Puan: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113474
    m_Localized: 'Rekor: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113475
    m_Localized: "YEN\u0130 REKOR!"
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113476
    m_Localized: x{0}
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113477
    m_Localized: '{0} Combo!'
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113478
    m_Localized: ': par skorun %{0}''i'
    m_Metadata:
      m_Items: []
  - m_Id: 2024595771113479
    m_Localized: ': par skorun %{0}''i'
    m_Metadata:
      m_Items: []
  - m_Id: 3526002961563648
    m_Localized: "T\xFCm Levelleri A\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 3526002978340864
    m_Localized: '{0}/{1} kart'
    m_Metadata:
      m_Items: []
  - m_Id: 8192240841146368
    m_Localized: "Reklam \u0130zle: Devam Et"
    m_Metadata:
      m_Items: []
  - m_Id: 8272253326213120
    m_Localized: "Bu, destede ka\xE7 kart kald\u0131\u011F\u0131n\u0131 g\xF6sterir.
      S\xFCre bitmeden bunu s\u0131f\u0131ra indirirsen kazan\u0131rs\u0131n!"
    m_Metadata:
      m_Items: []
  - m_Id: 8272253342990336
    m_Localized: "Hangi kart\u0131n hangi istasyona gitmesi gerekti\u011Fini g\xF6rmek
      i\xE7in buna istedi\u011Fin an dokunabilirsin - hi\xE7bir \u015Feyi durdurmaz,
      swipe atarken de kullanabilirsin."
    m_Metadata:
      m_Items: []
  - m_Id: 8272253342990337
    m_Localized: "Ekran\u0131n her kenar\u0131 bir istasyon. Zamanla yer de\u011Fi\u015Ftirirler,
      bu y\xFCzden kayd\u0131rmadan \xF6nce etikete mutlaka bak!"
    m_Metadata:
      m_Items: []
  - m_Id: 8272253342990338
    m_Localized: "Art arda do\u011Fru kayd\u0131rmalar burada bir kombo \xE7arpan\u0131
      biriktirir ve skorunu art\u0131r\u0131r - yanl\u0131\u015F bir kayd\u0131rma
      \xE7arpan\u0131 d\xFC\u015F\xFCr\xFCr."
    m_Metadata:
      m_Items: []
  - m_Id: 8272253342990339
    m_Localized: "Bu, b\xF6l\xFCm s\xFCren. S\xFCre s\u0131f\u0131rlanmadan \xF6nce
      b\xFCt\xFCn desteyi bitirmelisin!"
    m_Metadata:
      m_Items: []
  - m_Id: 8272253342990340
    m_Localized: "Devam etmek i\xE7in ekrana dokun"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
